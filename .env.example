# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Database URI (e.g. mongodb+srv://...)
# If not provided, the built-in high-performance persistent JSON store is automatically used
MONGODB_URI=""

# JWT Secret for admin and user authentication
JWT_SECRET="bismillah-state-agency-secure-jwt-secret-key"

# Cloudinary credentials for media upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public API URL (defaults to relative /api)
VITE_API_URL=""

# API Key or Base Endpoint (e.g. http://localhost:5000)
VITE_API_KEY=""

